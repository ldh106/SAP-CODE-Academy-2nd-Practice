<mvc:View controllerName="ncode.zc19w0106.controller.View1"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:layout = "sap.ui.layout"
    xmlns:f = "sap.ui.layout.form"
    xmlns:core="sap.ui.core"
>
    <Page id="page" title="{i18n>title}">
        <Panel expanded="true" expandable="true">
            <Label id = "laStudentCode" text = "학생번호"></Label>
            <Input id = "inpStudentCode"></Input>
            <Button id = "btnFind" text = "검색" press = "onClick" icon = "sap-icon://search"></Button>
        </Panel>
        <f:SimpleForm >
            <f:title>
                <core:Title text = "학생번호 조회 시스템"></core:Title>
            </f:title>
            <f:content>
                <core:Title text = "반"/>
                    <Input id = "inpStudentClass"></Input>                              
                <core:Title text = "조"/>
                    <Input id = "inpStudentTeam"></Input>
                <core:Title text = "학생명"/>                                        
                    <Input id = "inpStudentLastName"></Input>
                    <Input id = "inpStudentFirstName"></Input>
                <core:Title text = "역할"/>
                    <CheckBox id = "chkLeader" text = "조장"></CheckBox>                
            
            </f:content>
        
        </f:SimpleForm>
        
        
        
        
    </Page>
</mvc:View>