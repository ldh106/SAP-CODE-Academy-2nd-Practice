<mvc:View controllerName="ncode.zc19w0202.controller.View1"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f = "sap.ui.layout.form"
    xmlns:core = "sap.ui.core"
>
    <Page id="page" title="{i18n>title}">
        <Panel expanded="true" expandable="true" >
            <HBox >
                <Label text = "기술코드"></Label>
                <Input id = "inpSC" ></Input>
                <Button text = "검색" press = "onSearch" icon = "sap-icon://search"></Button>
            </HBox>
        </Panel>
        <f:SimpleForm >
            <f:title>
                <core:Title text = "기술코드 조회 시스템"></core:Title>
            </f:title>
            <f:content>
                <VBox >
                    <HBox >
                        <Label text = "기술코드"/>
                        <Input id = "rstSC"/>
                    </HBox>
                    <HBox >
                        <Label text = "기술등급"/>
                        <Input id = "rstG"/>                    
                    </HBox>
                    <HBox >
                        <Label text = "인원수" />
                        <Input id = "rstC"/>
                    </HBox>                    
                    <HBox >
                        <Label text = "담당자"/>
                        <Input id = "rstN"/>
                        <Button text = "상세정보" press = "onDetail" icon = "sap-icon://search"/>
                    </HBox>
                </VBox>
            </f:content>
        </f:SimpleForm>
    </Page>
</mvc:View>