<mvc:View controllerName="ncode.zc19w0203.controller.View1"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">
    <Page id="page" title="{i18n>title}">
        <VBox >
            <HBox >
                <Label text = "교재번호"></Label>
                <Input id = "inpBC" value = "{/bookInfo/code}"></Input>   
                <Button text = "클릭" press = "onPress"></Button>             
            </HBox>
            <HBox >
                <Label text = "교재명"></Label>
                <Input id = "inpBN" value="{/bookInfo/name}"></Input>                
            </HBox>            
            <Input value = "{empModel>/empName}" description = "담당자"></Input>                        
        </VBox>
    </Page>
</mvc:View>