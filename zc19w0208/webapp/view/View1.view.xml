<mvc:View controllerName="ncode.zc19w0208.controller.View1"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core = "sap.ui.core"
>
    <Page id="page" title="{i18n>title}">
        <HBox >
            <ComboBox id = "cbStd" items = "{stdInfo>/stdList}" >
                <items>
                    <core:Item key = "{stdInfo>stdNo}" text = "{stdInfo>stdName}"> </core:Item>
                </items>        
            </ComboBox>
            <Button text = "검색" press = "onGetInfo"></Button>
        </HBox>
        <Panel expandable="true" expanded="true">
            <content>
                <ComboBox id = "cbSkl" items = "{stdInfo>skills}">
                    <items>
                        <core:Item key = "{stdInfo>sCode}" text = "{stdInfo>sName}"></core:Item>
                    </items>
                </ComboBox>
            </content>
        </Panel>

    </Page>
</mvc:View>