<core:FragmentDefinition xmlns:form="sap.ui.layout.form"
    xmlns = "sap.m"
    xmlns:core = "sap.ui.core"    
>
    <Dialog title = "강사 정보" id = "idDialog">
        <buttons >
            <Button text = "Close" press = "onClose"/>
        </buttons>
        <content>
            <form:SimpleForm >
                <HBox >
                    <Label text = "메인 강사"></Label>
                    <Input id = "inpCTeacher" value = "{mInfo>cTeacher}" editable="false" 
                      ></Input>
                </HBox>  
                <HBox >
                    <Label text = "사내 강사"></Label>
                    <Input id = "inpCinTeacher" value = "{mInfo>cinTeacher}" editable="false" 
                    ></Input>
                </HBox>
            </form:SimpleForm>
        </content>
    </Dialog>
</core:FragmentDefinition>